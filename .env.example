# Application settings. Copy to .env and provide private values.
# Compose uses docker/.env.compose separately; use matching DB credentials.
SPRING_PROFILES_ACTIVE=local
# Local backend Compose resources; adjust independently of KURE resources.
APP_PORT=8080
APP_CPUS=2.0
APP_MEMORY_LIMIT=2g
APP_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=molelawdb
MYSQL_USER=molelaw
MYSQL_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Match docker/.env.compose. Never commit the actual password.
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false
QDRANT_HOST=127.0.0.1
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=law_chunks_v1
QDRANT_USE_TLS=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Primary keyword client uses temperature; keep reasoning disabled for this role.
OPENAI_CHAT_REASONING_EFFORT=none
# Decision base JSON (question/plan/history); catalog and body budgets are configured separately.
APP_AI_EVIDENCE_MAX_INPUT_TOKENS=2500
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OC_KEY=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: used only when the kakao profile is explicitly enabled.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
FRONTENDURI=http://localhost:3000
COOKIE_SECURE=false
# Required AES-256-GCM key: Base64 of 32 random bytes, managed in .env or process environment.
# application.yml imports .env and EncryptUtil receives Spring properties through @Value.
CHAT_ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY_VERSION=v1

# Internal law RAG tools must be enabled for first-question collection.
APP_LAW_VECTOR_ENABLED=true
# Total embedding time per execution (all law/query batches), separate from consultation processing.
APP_LAW_VECTOR_EMBEDDING_TIMEOUT_SECONDS=900
# Per embedding HTTP request. Expired results are discarded; server-side inference may continue.
APP_LAW_VECTOR_EMBEDDING_READ_TIMEOUT_MILLIS=120000
APP_LAW_VECTOR_EMBEDDING_BASE_URL=http://localhost:11437
# Set 1 only when using docker/kure/compose.gpu.yml; CPU is the portable default.
APP_LAW_VECTOR_GPU_COUNT=0
APP_LAW_VECTOR_THREADS=6
APP_LAW_VECTOR_QDRANT_BASE_URL=http://localhost:6333
APP_LAW_VECTOR_COLLECTION_NAME=molelaw_service_law_kure_v1

# Optional local cross-encoder after Qdrant candidate retrieval.
APP_LAW_RERANKER_ENABLED=false
APP_LAW_RERANKER_BASE_URL=http://localhost:11437
APP_LAW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
APP_LAW_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
APP_LAW_RERANKER_CANDIDATE_LIMIT=50
APP_LAW_RERANKER_READ_TIMEOUT_MILLIS=30000

# Production defaults: Secure=true, SameSite=None. local profile uses Lax.
COOKIE_SAME_SITE=Lax
# Optional explicit comma-separated CORS origins; defaults to FRONTENDURI.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# docker/kure/compose.yml 사용 시 APP_LAW_VECTOR_EMBEDDING_BASE_URL=http://localhost:11437

# 최초 상담 검색 경로: QDRANT(기본) 또는 AI_SEARCH(제공자 정상 응답 확인 후 사용)
APP_LAW_RETRIEVAL_BACKEND=QDRANT
# Law list reranker policy; local experiments may use score 60 / max 3.
APP_LAW_CANDIDATE_MINIMUM_SCORE=70
APP_LAW_CANDIDATE_MAX_CANDIDATES=2
APP_LAW_AI_SEARCH_BASE_URL=https://www.law.go.kr/DRF
# Role-specific reasoning models; completion limits include reasoning tokens.
APP_AI_QUESTION_MODEL=gpt-5.4-mini
APP_AI_QUESTION_REASONING_EFFORT=low
APP_AI_QUESTION_MAX_COMPLETION_TOKENS=4096
APP_AI_CANDIDATE_MODEL=gpt-5.4-mini
APP_AI_CANDIDATE_REASONING_EFFORT=low
APP_AI_CANDIDATE_MAX_COMPLETION_TOKENS=8192
APP_AI_EVIDENCE_MODEL=gpt-5.4
APP_AI_EVIDENCE_REASONING_EFFORT=medium
APP_AI_EVIDENCE_MAX_COMPLETION_TOKENS=12288
APP_AI_ANSWER_MODEL=gpt-5.4-mini
APP_AI_ANSWER_REASONING_EFFORT=medium
APP_AI_ANSWER_MAX_COMPLETION_TOKENS=16384
APP_AI_READ_TIMEOUT_MS=120000
# Per-execution HTTP call budgets, independent of retrieval/API calls.
APP_LAW_VECTOR_EMBEDDING_MAX_CALLS=1024
APP_LAW_VECTOR_INDEXING_MAX_CALLS=1024
# First-question evidence catalog, full-body reads, and combined decision input.
APP_AI_READ_MODEL=gpt-5.4-mini
APP_AI_READ_REASONING_EFFORT=low
APP_AI_READ_MAX_COMPLETION_TOKENS=4096
APP_AI_EVIDENCE_CATALOG_MAX_INPUT_TOKENS=4000
APP_AI_EVIDENCE_BODY_MAX_INPUT_TOKENS=12000
APP_AI_EVIDENCE_DECISION_MAX_INPUT_TOKENS=20000
# Initial consultation SSE admission, MVC writer pool, and idle timeout.
APP_CHAT_STREAM_MAX_CONCURRENT=4
APP_CHAT_STREAM_WRITE_THREADS=4
APP_CHAT_STREAM_TIMEOUT=20m
# Consented case retrieval: law/fact routes -> bounded judgment bodies -> LLM rerank.
APP_CASE_SEARCH_MAX_API_CALLS=64
APP_CASE_SEARCH_MAX_CANDIDATES=5000
APP_CASE_SEARCH_MAX_DETAILS=6
APP_CASE_SEARCH_DETAILS_PER_SEARCH=4
APP_CASE_SEARCH_MAX_SELECTED=2
APP_CASE_SEARCH_MINIMUM_SCORE=60
APP_CASE_SEARCH_EXCERPT_CHARS=4000
APP_CASE_SEARCH_MAX_RERANK_CALLS=2
APP_AI_CASE_RERANK_MODEL=gpt-5.4-mini
APP_AI_CASE_RERANK_REASONING_EFFORT=low
APP_AI_CASE_RERANK_MAX_COMPLETION_TOKENS=4096
APP_AI_CASE_QUERY_MODEL=gpt-5.4-mini
APP_AI_CASE_QUERY_REASONING_EFFORT=low
APP_AI_CASE_QUERY_MAX_COMPLETION_TOKENS=2048
