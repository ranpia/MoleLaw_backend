# Copy to .env.compose and fill in all three secrets before starting.
# This file configures Docker Compose, not the Spring application.
MYSQL_DATABASE=molelawdb
MYSQL_USER=molelaw
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
QDRANT_API_KEY=

# Use the database host's LAN IP here when serving another computer.
DB_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3307
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Resource ceilings, not preallocated or reserved resources.
MYSQL_CPUS=2.0
MYSQL_MEMORY_LIMIT=2g
MYSQL_BUFFER_POOL_SIZE=1G
MYSQL_MAX_CONNECTIONS=100
QDRANT_CPUS=4.0
QDRANT_MEMORY_LIMIT=6g
