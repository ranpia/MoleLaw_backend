# Compose configuration. Copy to docker/kure/.env and pass --env-file docker/kure/.env.
KURE_SERVICE_PORT=11437
KURE_MODEL_VOLUME=molelaw-kure-models
KURE_THREADS=6
KURE_QUEUE_CAPACITY=4
KURE_QUEUE_WAIT_SECONDS=5
# First start downloads the pinned model before opening HTTP.
KURE_START_PERIOD=10m
# Optional overrides. CPU defaults: batch 16, 6 CPUs, 8g RAM.
# GPU defaults: batch 4, 4 CPUs, 4g RAM. Tune to host and input sizes.
# KURE_BATCH_SIZE=4
# KURE_CPUS=4.0
# KURE_MEMORY_LIMIT=4g
# Physical NVIDIA index; exposed as CUDA device 0 inside the container.
KURE_GPU_DEVICE_ID=0
# Optional cross-encoder shares the embedding inference queue and model cache.
KURE_RERANKER_ENABLED=false
KURE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KURE_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
KURE_RERANKER_BATCH_SIZE=2
KURE_RERANKER_MAX_TOKENS=1024
