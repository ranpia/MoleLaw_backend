        "type": "prometheus",
        "uid": "loadtest-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_innodb_row_lock_current_waits",
          "legendFormat": "MySQL 현재 행 잠금 대기"
