{
  "uid": "molelaw-loadtest-databases",
  "title": "MoleLaw 부하 테스트 - MySQL·Redis",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "MySQL 연결 상태",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loadtest-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_up",
          "legendFormat": "MySQL 연결 상태"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "MySQL 연결·실행 스레드",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loadtest-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "연결"
        },
        {
          "refId": "B",
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "실행 중"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "MySQL 초당 쿼리 수",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loadtest-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_queries[1m])",
          "legendFormat": "MySQL 초당 쿼리 수"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "MySQL 현재 행 잠금 대기",
