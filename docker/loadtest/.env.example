# Local load-test values ONLY. Do not copy production/development secrets here.
# Copy to docker/loadtest/.env (gitignored) and fill all blank secrets.
LT_MYSQL_PASSWORD=
LT_MYSQL_ROOT_PASSWORD=
# Redis: 32+ random letters/digits/underscore/hyphen.
LT_REDIS_PASSWORD=
LT_QDRANT_API_KEY=
# JWT: 32+ random bytes encoded as text. Chat: Base64 of exactly 32 random bytes.
LT_JWT_SECRET=
LT_CHAT_ENCRYPTION_KEY=
LT_GRAFANA_PASSWORD=
# Synthetic users share this local-only 32-72 byte random password. Required only for --profile data.
LT_DATA_PASSWORD=

LT_BACKEND_PORT=18080
LT_MYSQL_PORT=13307
LT_QDRANT_HTTP_PORT=16333
LT_QDRANT_GRPC_PORT=16334
LT_KURE_PORT=21437
LT_PROMETHEUS_PORT=19090
LT_GRAFANA_PORT=13000

LT_BACKEND_CPUS=2.0
LT_BACKEND_MEMORY=2g
LT_MYSQL_CPUS=1.0
LT_MYSQL_MEMORY=1536m
LT_MYSQL_POOL_SIZE=10
LT_QDRANT_CPUS=2.0
LT_QDRANT_MEMORY=2g
LT_KURE_CPUS=4.0
LT_KURE_MEMORY=6g
LT_KURE_THREADS=4
LT_KURE_BATCH_SIZE=16
LT_KURE_QUEUE_CAPACITY=4
LT_KURE_QUEUE_WAIT_SECONDS=5
LT_RERANK_CANDIDATES=50
# Start false for ordinary API checks. Set true AND enable Compose --profile rag for real retrieval.
LT_RAG_ENABLED=false
