    "specialSources":  [
                           {
                               "id":  "minimum-notice",
                               "lawId":  "minimum-notice",
                               "heading":  "최저임금법 제5조에 따른 단순노무직종 근로자 지정 고시",
                               "mst":  "2100000118064",
                               "effectiveDate":  "2018-03-20",
                               "provisionType":  "notice",
                               "text":  "최저임금법 제5조제2항에 따른 \"단순노무업무로 고용노동부장관이 정하여 고시한 직종에 종사하는 근로자\"란 한국표준직업분류 상 대분류 9(단순노무 종사자)에 해당하는 사람을 말한다.",
